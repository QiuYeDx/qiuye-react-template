# 公共环境变量（会被打包进前端代码，切勿放置任何密钥）
# 本地覆盖请新建 .env.local（已被 git 忽略）

# 应用名称，用于页面标题与页头
VITE_APP_TITLE=QiuYe React Template
# 应用描述，用于 <meta name="description">
VITE_APP_DESCRIPTION=A modern, elegant React + Vite starter built on the latest shadcn/ui.
# 接口基础地址，可以是绝对地址，也可以是配合 Vite 代理的相对路径
VITE_API_BASE_URL=/api
